# Copy to `.env` (gitignored) and fill in. Every value is optional; unset ones
# fall back to the process environment, so an existing shell export still works.

# Filesystem layout. Defaults are <repo>/data, <repo>/checkpoints, <repo>/outputs;
# override to put datasets or checkpoints on another disk.
# DATA_ROOT=/mnt/big-disk/chessqueries/data
# CHECKPOINTS_ROOT=/mnt/big-disk/chessqueries/checkpoints
# OUTPUTS_ROOT=/mnt/big-disk/chessqueries/outputs
